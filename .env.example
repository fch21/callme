# ----- Required -----
OPENAI_API_KEY=
PERSONA_NAME=Your Name

# ----- Voice (optional) -----
# Set VOICE_MODE to 'preset' or 'cloned' to enable TTS playback.
# 'off' (default) returns text only, and the frontend renders chat mode instead of call mode.
VOICE_MODE=off
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ----- Push notifications (optional) -----
# When set, you'll get a push notification whenever the AI captures a visitor's email.
# Without these, captures still get logged to me/leads.jsonl locally.
# Sign up at pushover.net (free), create an Application, then copy the keys here.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# ----- Models -----
# Default: gpt-5.4-mini (released March 2026 — fast, cheap, supports tool calling).
# For higher accuracy, swap to gpt-5.5 or gpt-5.4 (more expensive).
# For lowest cost, swap to gpt-5.4-nano. Full list: platform.openai.com/docs/models
CHAT_MODEL=gpt-5.4-mini
EVALUATOR_MODEL=gpt-5.4-mini

# ----- CORS (production) -----
# Comma-separated list of allowed origins. In dev, the default works.
ALLOWED_ORIGINS=http://localhost:3000
